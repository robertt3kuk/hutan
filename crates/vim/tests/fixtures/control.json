{
  "vim": "VIM - Vi IMproved 9.1, patches 1-1752 (/usr/bin/vim -Nu NONE -i NONE -es)",
  "cases": [
    {"name": "i_CTRL-C leaves Insert", "lines": ["abc"], "cursor": [1,2], "keys": "iXY<C-c>", "expect": {"cursor":[1,3],"lines":["aXYbc"],"registers":{".":["XY","v"]}}},
    {"name": "3i and CTRL-C: no repeat", "lines": ["abc"], "cursor": [1,1], "keys": "3ix<C-c>", "expect": {"cursor":[1,3],"lines":["xxxabc"],"registers":{".":["x","v"]}}},
    {"name": "d CTRL-C cancels", "lines": ["abc def"], "cursor": [1,1], "keys": "d<C-c>x", "expect": {"cursor":[1,1],"lines":["bc def"],"registers":{"\"":["a","v"],"-":["a","v"]}}},
    {"name": "v CTRL-C leaves Visual", "lines": ["abc def"], "cursor": [1,1], "keys": "vl<C-c>x", "expect": {"cursor":[1,2],"lines":["ac def"],"registers":{"\"":["b","v"],"-":["b","v"]}}},
    {"name": "block I and CTRL-C: one line", "lines": ["abc","def","ghi"], "cursor": [1,1], "keys": "<C-v>jjIX<C-c>", "expect": {"cursor":[1,1],"lines":["Xabc","Xdef","Xghi"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-W a word", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "A<C-w>X<Esc>", "expect": {"cursor":[1,9],"lines":["foo bar X"],"registers":{".":["\u0017X","v"]}}},
    {"name": "i_CTRL-W after blanks", "lines": ["foo bar   "], "cursor": [1,1], "keys": "A<C-w>X<Esc>", "expect": {"cursor":[1,5],"lines":["foo X"],"registers":{".":["\u0017X","v"]}}},
    {"name": "i_CTRL-W punctuation", "lines": ["foo.bar()"], "cursor": [1,1], "keys": "A<C-w><C-w>X<Esc>", "expect": {"cursor":[1,5],"lines":["foo.X"],"registers":{".":["\u0017\u0017X","v"]}}},
    {"name": "i_CTRL-W stops at the start of the insert", "lines": ["foo bar"], "cursor": [1,1], "keys": "Abaz<C-w>X<Esc>", "expect": {"cursor":[1,8],"lines":["foo barX"],"registers":{".":["baz\u0017X","v"]}}},
    {"name": "i_CTRL-W twice passes the start", "lines": ["foo bar"], "cursor": [1,1], "keys": "Abaz<C-w><C-w>X<Esc>", "expect": {"cursor":[1,5],"lines":["foo X"],"registers":{".":["baz\u0017\u0017X","v"]}}},
    {"name": "i_CTRL-W at a line start joins", "lines": ["abc","def"], "cursor": [2,1], "keys": "i<C-w>X<Esc>", "expect": {"cursor":[1,4],"lines":["abcXdef"],"registers":{".":["\u0017X","v"]}}},
    {"name": "i_CTRL-W in the middle", "lines": ["foo bar baz"], "cursor": [1,8], "keys": "i<C-w>X<Esc>", "expect": {"cursor":[1,5],"lines":["foo X baz"],"registers":{".":["\u0017X","v"]}}},
    {"name": "i_CTRL-U typed text", "lines": ["foo bar"], "cursor": [1,1], "keys": "Abaz<C-u>X<Esc>", "expect": {"cursor":[1,8],"lines":["foo barX"],"registers":{".":["baz\u0015X","v"]}}},
    {"name": "i_CTRL-U twice", "lines": ["foo bar"], "cursor": [1,1], "keys": "Abaz<C-u><C-u>X<Esc>", "expect": {"cursor":[1,1],"lines":["X"],"registers":{".":["baz\u0015\u0015X","v"]}}},
    {"name": "i_CTRL-U keeps the indent", "lines": ["    foo bar"], "cursor": [1,1], "keys": "A<C-u>X<Esc>", "expect": {"cursor":[1,1],"lines":["X"],"registers":{".":["\u0015X","v"]}}},
    {"name": "i_CTRL-U in the middle", "lines": ["foo bar"], "cursor": [1,5], "keys": "i<C-u>X<Esc>", "expect": {"cursor":[1,1],"lines":["Xbar"],"registers":{".":["\u0015X","v"]}}},
    {"name": "i_CTRL-U at a line start joins", "lines": ["abc","def"], "cursor": [2,1], "keys": "i<C-u>X<Esc>", "expect": {"cursor":[1,4],"lines":["abcXdef"],"registers":{".":["\u0015X","v"]}}},
    {"name": "i_CTRL-H", "lines": ["abc"], "cursor": [1,1], "keys": "A<C-h><C-h>X<Esc>", "expect": {"cursor":[1,2],"lines":["aX"],"registers":{".":["\b\bX","v"]}}},
    {"name": "i_CTRL-H joins lines", "lines": ["abc","def"], "cursor": [2,1], "keys": "i<C-h>X<Esc>", "expect": {"cursor":[1,4],"lines":["abcXdef"],"registers":{".":["\bX","v"]}}},
    {"name": "i_CTRL-J", "lines": ["abc def"], "cursor": [1,4], "keys": "i<C-j>X<Esc>", "expect": {"cursor":[2,1],"lines":["abc","X def"],"registers":{".":["\nX","v"]}}},
    {"name": "i_CTRL-M", "lines": ["abc def"], "cursor": [1,4], "keys": "i<C-m>X<Esc>", "expect": {"cursor":[2,1],"lines":["abc","X def"],"registers":{".":["\nX","v"]}}},
    {"name": "i_CTRL-T", "lines": ["foo"], "cursor": [1,2], "keys": "i<C-t>X<Esc>", "expect": {"cursor":[1,3],"lines":["\tfXoo"],"registers":{".":["\u0014X","v"]}}},
    {"name": "i_CTRL-T with spaces", "lines": ["foo"], "cursor": [1,2], "set": "shiftwidth=4 expandtab", "keys": "a<C-t><C-t>X<Esc>", "expect": {"cursor":[1,11],"lines":["        foXo"],"registers":{".":["\u0014\u0014X","v"]}}},
    {"name": "i_CTRL-T rounds", "lines": ["  foo"], "cursor": [1,4], "set": "shiftwidth=4 expandtab", "keys": "i<C-t>X<Esc>", "expect": {"cursor":[1,6],"lines":["    fXoo"],"registers":{".":["\u0014X","v"]}}},
    {"name": "i_CTRL-D", "lines": ["        foo"], "cursor": [1,10], "set": "shiftwidth=4 expandtab", "keys": "i<C-d>X<Esc>", "expect": {"cursor":[1,6],"lines":["    fXoo"],"registers":{".":["\u0004X","v"]}}},
    {"name": "i_CTRL-D rounds", "lines": ["      foo"], "cursor": [1,8], "set": "shiftwidth=4 expandtab", "keys": "i<C-d>X<Esc>", "expect": {"cursor":[1,6],"lines":["    fXoo"],"registers":{".":["\u0004X","v"]}}},
    {"name": "i_CTRL-D without indent", "lines": ["foo"], "cursor": [1,1], "keys": "A<C-d>X<Esc>", "expect": {"cursor":[1,4],"lines":["fooX"],"registers":{".":["\u0004X","v"]}}},
    {"name": "i_CTRL-D with a tab", "lines": ["\tfoo"], "cursor": [1,1], "keys": "A<C-d>X<Esc>", "expect": {"cursor":[1,4],"lines":["fooX"],"registers":{".":["\u0004X","v"]}}},
    {"name": "i_CTRL-D caret in the indent", "lines": ["        foo"], "cursor": [1,3], "set": "shiftwidth=4 expandtab", "keys": "i<C-d>X<Esc>", "expect": {"cursor":[1,1],"lines":["X    foo"],"registers":{".":["\u0004X","v"]}}},
    {"name": "i_CTRL-O 0", "lines": ["abc def"], "cursor": [1,7], "keys": "A<C-o>0X<Esc>", "expect": {"cursor":[1,1],"lines":["Xabc def"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-O at the end stays at the end", "lines": ["abc"], "cursor": [1,1], "keys": "A<C-o>maX<Esc>", "expect": {"cursor":[1,4],"lines":["abcX"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-O dw", "lines": ["abc def ghi"], "cursor": [1,1], "keys": "i<C-o>dwX<Esc>", "expect": {"cursor":[1,1],"lines":["Xdef ghi"],"registers":{"\"":["abc ","v"],"-":["abc ","v"],".":["X","v"]}}},
    {"name": "i_CTRL-O $", "lines": ["abc def"], "cursor": [1,1], "keys": "i<C-o>$X<Esc>", "expect": {"cursor":[1,8],"lines":["abc defX"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-O with a count", "lines": ["abc def ghi"], "cursor": [1,1], "keys": "i<C-o>2wX<Esc>", "expect": {"cursor":[1,9],"lines":["abc def Xghi"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-O in the middle", "lines": ["abc def"], "cursor": [1,3], "keys": "i<C-o>lX<Esc>", "expect": {"cursor":[1,4],"lines":["abcX def"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-O and typing before", "lines": ["abc def"], "cursor": [1,1], "keys": "iXY<C-o>wZ<Esc>", "expect": {"cursor":[1,7],"lines":["XYabc Zdef"],"registers":{".":["Z","v"]}}},
    {"name": "i_CTRL-O j", "lines": ["abc","defgh"], "cursor": [1,1], "keys": "A<C-o>jX<Esc>", "expect": {"cursor":[2,4],"lines":["abc","defXgh"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-R a register", "lines": ["abc def"], "cursor": [1,1], "keys": "\"ayiwA <C-r>a<Esc>", "expect": {"cursor":[1,11],"lines":["abc def abc"],"registers":{"\"":["abc","v"],".":[" abc","v"],"a":["abc","v"]}}},
    {"name": "i_CTRL-R a linewise register", "lines": ["abc"], "cursor": [1,1], "keys": "yyA<C-r>\"<Esc>", "expect": {"cursor":[2,1],"lines":["abcabc",""],"registers":{"\"":["abc\n","V"],".":["abc\n","v"],"0":["abc\n","V"]}}},
    {"name": "i_CTRL-R the last insert", "lines": ["abc"], "cursor": [1,1], "keys": "iXY<Esc>A<C-r>.<Esc>", "expect": {"cursor":[1,7],"lines":["XYabcXY"],"registers":{".":["XY","v"]}}},
    {"name": "i_CTRL-R Escape", "lines": ["abc"], "cursor": [1,1], "keys": "A<C-r><Esc>X<Esc>", "expect": {"cursor":[1,4],"lines":["abcX"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-A", "lines": ["abc"], "cursor": [1,1], "keys": "iXY<Esc>A<C-a><Esc>", "expect": {"cursor":[1,7],"lines":["XYabcXY"],"registers":{".":["XY","v"]}}},
    {"name": "i_CTRL-E", "lines": ["abc","xyz"], "cursor": [1,1], "keys": "i<C-e><C-e>X<Esc>", "expect": {"cursor":[1,3],"lines":["xyXabc","xyz"],"registers":{".":["xyX","v"]}}},
    {"name": "i_CTRL-Y", "lines": ["abc","xy"], "cursor": [2,1], "keys": "i<C-y><C-y><C-y><Esc>", "expect": {"cursor":[2,3],"lines":["abc","abcxy"],"registers":{".":["abc","v"]}}},
    {"name": "i_CTRL-E past the end of the line below", "lines": ["abcdef","x"], "cursor": [1,4], "keys": "i<C-e>X<Esc>", "expect": {"cursor":[1,4],"lines":["abcXdef","x"],"registers":{".":["X","v"]}}},
    {"name": "i_CTRL-Y on the first line", "lines": ["abc"], "cursor": [1,1], "keys": "i<C-y>X<Esc>", "expect": {"cursor":[1,1],"lines":["Xabc"],"registers":{".":["X","v"]}}}
  ]
}
