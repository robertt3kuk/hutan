{
  "vim": "VIM - Vi IMproved 9.1, patches 1-1752 (/usr/bin/vim -Nu NONE -i NONE -es)",
  "cases": [
    {"name": "s first match", "lines": ["foo foo","foo"], "cursor": [1,1], "keys": ":s/foo/bar/<CR>", "expect": {"cursor":[1,1],"lines":["bar foo","foo"],"registers":{"/":["foo","v"],":":["s/foo/bar/","v"]}}},
    {"name": "s global flag", "lines": ["foo foo","foo"], "cursor": [1,1], "keys": ":s/foo/bar/g<CR>", "expect": {"cursor":[1,1],"lines":["bar bar","foo"],"registers":{"/":["foo","v"],":":["s/foo/bar/g","v"]}}},
    {"name": "percent s", "lines": ["foo foo","  foo"], "cursor": [1,1], "keys": ":%s/foo/bar/g<CR>", "expect": {"cursor":[2,3],"lines":["bar bar","  bar"],"registers":{"/":["foo","v"],":":["%s/foo/bar/g","v"]}}},
    {"name": "s with a range", "lines": ["a","a","a","a"], "cursor": [1,1], "keys": ":2,3s/a/b/<CR>", "expect": {"cursor":[3,1],"lines":["a","b","b","a"],"registers":{"/":["a","v"],":":["2,3s/a/b/","v"]}}},
    {"name": "s with relative range", "lines": ["a","a","a","a"], "cursor": [2,1], "keys": ":.,+1s/a/b/<CR>", "expect": {"cursor":[3,1],"lines":["a","b","b","a"],"registers":{"/":["a","v"],":":[".,+1s/a/b/","v"]}}},
    {"name": "s with dollar", "lines": ["a","a","a"], "cursor": [1,1], "keys": ":2,$s/a/b/<CR>", "expect": {"cursor":[3,1],"lines":["a","b","b"],"registers":{"/":["a","v"],":":["2,$s/a/b/","v"]}}},
    {"name": "s groups", "lines": ["john smith"], "cursor": [1,1], "keys": ":s/\\(\\w\\+\\) \\(\\w\\+\\)/\\2 \\1/<CR>", "expect": {"cursor":[1,1],"lines":["smith john"],"registers":{"/":["\\(\\w\\+\\) \\(\\w\\+\\)","v"],":":["s/\\(\\w\\+\\) \\(\\w\\+\\)/\\2 \\1/","v"]}}},
    {"name": "s ampersand", "lines": ["foo bar"], "cursor": [1,1], "keys": ":s/bar/[&]/<CR>", "expect": {"cursor":[1,1],"lines":["foo [bar]"],"registers":{"/":["bar","v"],":":["s/bar/[&]/","v"]}}},
    {"name": "s case modifiers", "lines": ["foo bar"], "cursor": [1,1], "keys": ":s/\\w\\+/\\u&/g<CR>", "expect": {"cursor":[1,1],"lines":["Foo Bar"],"registers":{"/":["\\w\\+","v"],":":["s/\\w\\+/\\u&/g","v"]}}},
    {"name": "s upper all", "lines": ["foo bar"], "cursor": [1,1], "keys": ":s/foo/\\U&-x\\E!/<CR>", "expect": {"cursor":[1,1],"lines":["FOO-X! bar"],"registers":{"/":["foo","v"],":":["s/foo/\\U&-x\\E!/","v"]}}},
    {"name": "s splits a line", "lines": ["a,b,c"], "cursor": [1,1], "keys": ":s/,/\\r/g<CR>", "expect": {"cursor":[3,1],"lines":["a","b","c"],"registers":{"/":[",","v"],":":["s/,/\\r/g","v"]}}},
    {"name": "s empty pattern reuses the search", "lines": ["foo bar foo"], "cursor": [1,1], "keys": "/foo<CR>:s//X/g<CR>", "expect": {"cursor":[1,1],"lines":["X bar X"],"registers":{"/":["foo","v"],":":["s//X/g","v"]}}},
    {"name": "s ignore case flag", "lines": ["Foo foo"], "cursor": [1,1], "keys": ":s/foo/x/gi<CR>", "expect": {"cursor":[1,1],"lines":["x x"],"registers":{"/":["foo","v"],":":["s/foo/x/gi","v"]}}},
    {"name": "s with another delimiter", "lines": ["a/b/c"], "cursor": [1,1], "keys": ":s#/#-#g<CR>", "expect": {"cursor":[1,1],"lines":["a-b-c"],"registers":{"/":["/","v"],":":["s#/#-#g","v"]}}},
    {"name": "s not found", "lines": ["abc"], "cursor": [1,2], "keys": ":s/x/y/<CR>", "expect": {"cursor":[1,2],"lines":["abc"],"registers":{"/":["x","v"],":":["s/x/y/","v"]}}},
    {"name": "s e flag", "lines": ["abc"], "cursor": [1,2], "keys": ":s/x/y/e<CR>", "expect": {"cursor":[1,2],"lines":["abc"],"registers":{"/":["x","v"],":":["s/x/y/e","v"]}}},
    {"name": "s n flag counts only", "lines": ["aaa"], "cursor": [1,1], "keys": ":s/a/b/gn<CR>", "expect": {"cursor":[1,1],"lines":["aaa"],"registers":{"/":["a","v"],":":["s/a/b/gn","v"]}}},
    {"name": "s count", "lines": ["a","a","a","a"], "cursor": [1,1], "keys": ":s/a/b/ 2<CR>", "expect": {"cursor":[2,1],"lines":["b","b","a","a"],"registers":{"/":["a","v"],":":["s/a/b/ 2","v"]}}},
    {"name": "s tilde reuses the replacement", "lines": ["a b","c d"], "cursor": [1,1], "keys": ":s/a/X/<CR>j:s/c/~Y/<CR>", "expect": {"cursor":[2,1],"lines":["X b","XY d"],"registers":{"/":["c","v"],":":["s/c/~Y/","v"]}}},
    {"name": "s very magic", "lines": ["ab12"], "cursor": [1,1], "keys": ":s/\\v(\\a+)(\\d+)/\\2\\1/<CR>", "expect": {"cursor":[1,1],"lines":["12ab"],"registers":{"/":["\\v(\\a+)(\\d+)","v"],":":["s/\\v(\\a+)(\\d+)/\\2\\1/","v"]}}},
    {"name": "ampersand repeats", "lines": ["foo foo","foo foo"], "cursor": [1,1], "keys": ":s/foo/x/<CR>j&", "expect": {"cursor":[2,1],"lines":["x foo","x foo"],"registers":{"/":["foo","v"],":":["s","v"]}}},
    {"name": "colon ampersand ampersand keeps flags", "lines": ["foo foo","foo foo"], "cursor": [1,1], "keys": ":s/foo/x/g<CR>j:&&<CR>", "expect": {"cursor":[2,1],"lines":["x x","x x"],"registers":{"/":["foo","v"],":":["&&","v"]}}},
    {"name": "s repeat with flags", "lines": ["foo foo","foo foo"], "cursor": [1,1], "keys": ":s/foo/x/<CR>j:s g<CR>", "expect": {"cursor":[2,1],"lines":["x foo","x x"],"registers":{"/":["foo","v"],":":["s g","v"]}}},
    {"name": "visual range s", "lines": ["a","a","a"], "cursor": [1,1], "keys": "Vj:s/a/b/<CR>", "expect": {"cursor":[2,1],"lines":["b","b","a"],"registers":{"/":["a","v"],":":["'<,'>s/a/b/","v"]}}},
    {"name": "count colon", "lines": ["a","a","a","a"], "cursor": [1,1], "keys": "3:s/a/b/<CR>", "expect": {"cursor":[3,1],"lines":["b","b","b","a"],"registers":{"/":["a","v"],":":[".,.+2s/a/b/","v"]}}},
    {"name": "g d", "lines": ["keep","drop 1","keep","drop 2"], "cursor": [1,1], "keys": ":g/drop/d<CR>", "expect": {"cursor":[2,1],"lines":["keep","keep"],"registers":{"\"":["drop 2\n","V"],"/":["drop","v"],"1":["drop 2\n","V"],"2":["drop 1\n","V"],":":["g/drop/d","v"]}}},
    {"name": "v d", "lines": ["keep","drop 1","keep","drop 2"], "cursor": [1,1], "keys": ":v/drop/d<CR>", "expect": {"cursor":[2,1],"lines":["drop 1","drop 2"],"registers":{"\"":["keep\n","V"],"/":["drop","v"],"1":["keep\n","V"],"2":["keep\n","V"],":":["v/drop/d","v"]}}},
    {"name": "g bang d", "lines": ["keep","drop 1","keep"], "cursor": [1,1], "keys": ":g!/drop/d<CR>", "expect": {"cursor":[1,1],"lines":["drop 1"],"registers":{"\"":["keep\n","V"],"/":["drop","v"],"1":["keep\n","V"],"2":["keep\n","V"],":":["g!/drop/d","v"]}}},
    {"name": "g s", "lines": ["x a","y a","x b"], "cursor": [1,1], "keys": ":g/x/s/\\w$/Z/<CR>", "expect": {"cursor":[3,1],"lines":["x Z","y a","x Z"],"registers":{"/":["\\w$","v"],":":["g/x/s/\\w$/Z/","v"]}}},
    {"name": "g normal", "lines": ["a","b","a"], "cursor": [1,1], "keys": ":g/a/normal A!<CR>", "expect": {"cursor":[3,2],"lines":["a!","b","a!"],"registers":{".":["!","v"],"/":["a","v"],":":["g/a/normal A!","v"]}}},
    {"name": "g with consecutive deletes", "lines": ["x","x","y","x"], "cursor": [1,1], "keys": ":g/x/d<CR>", "expect": {"cursor":[1,1],"lines":["y"],"registers":{"\"":["x\n","V"],"/":["x","v"],"1":["x\n","V"],"2":["x\n","V"],"3":["x\n","V"],":":["g/x/d","v"]}}},
    {"name": "g join", "lines": ["a","1","a","2"], "cursor": [1,1], "keys": ":g/a/j<CR>", "expect": {"cursor":[2,1],"lines":["a 1","a 2"],"registers":{"/":["a","v"],":":["g/a/j","v"]}}},
    {"name": "g move to the top reverses", "lines": ["1","2","3"], "cursor": [1,1], "keys": ":g/^/m0<CR>", "expect": {"cursor":[1,1],"lines":["3","2","1"],"registers":{"/":["^","v"],":":["g/^/m0","v"]}}},
    {"name": "g on a range", "lines": ["x","x","x","x"], "cursor": [1,1], "keys": ":2,3g/x/s//y/<CR>", "expect": {"cursor":[3,1],"lines":["x","y","y","x"],"registers":{"/":["x","v"],":":["2,3g/x/s//y/","v"]}}},
    {"name": "normal on a range", "lines": ["a","b","c"], "cursor": [1,1], "keys": ":%normal Ax<CR>", "expect": {"cursor":[3,2],"lines":["ax","bx","cx"],"registers":{".":["x","v"],":":["%normal Ax","v"]}}},
    {"name": "normal at the caret", "lines": ["abc"], "cursor": [1,2], "keys": ":normal x<CR>", "expect": {"cursor":[1,2],"lines":["ac"],"registers":{"\"":["b","v"],"-":["b","v"],":":["normal x","v"]}}},
    {"name": "normal with insert", "lines": ["a","b"], "cursor": [1,1], "keys": ":%norm I- <CR>", "expect": {"cursor":[2,2],"lines":["- a","- b"],"registers":{".":["- ","v"],":":["%norm I- ","v"]}}},
    {"name": "d range", "lines": ["1","2","3","4","5"], "cursor": [1,1], "keys": ":2,3d<CR>", "expect": {"cursor":[2,1],"lines":["1","4","5"],"registers":{"\"":["2\n3\n","V"],"1":["2\n3\n","V"],":":["2,3d","v"]}}},
    {"name": "d with register and count", "lines": ["1","2","3","4","5"], "cursor": [1,1], "keys": ":2d a 2<CR>", "expect": {"cursor":[2,1],"lines":["1","4","5"],"registers":{"\"":["2\n3\n","V"],"1":["2\n3\n","V"],":":["2d a 2","v"],"a":["2\n3\n","V"]}}},
    {"name": "d last line", "lines": ["1","2","3"], "cursor": [1,1], "keys": ":$d<CR>", "expect": {"cursor":[2,1],"lines":["1","2"],"registers":{"\"":["3\n","V"],"1":["3\n","V"],":":["$d","v"]}}},
    {"name": "y range then put", "lines": ["1","2","3"], "cursor": [1,1], "keys": ":1,2y<CR>Gp", "expect": {"cursor":[4,1],"lines":["1","2","3","1","2"],"registers":{"\"":["1\n2\n","V"],"0":["1\n2\n","V"],":":["1,2y","v"]}}},
    {"name": "y into a register", "lines": ["1","2","3"], "cursor": [1,1], "keys": ":3y b<CR>", "expect": {"cursor":[1,1],"lines":["1","2","3"],"registers":{"\"":["3\n","V"],":":["3y b","v"],"b":["3\n","V"]}}},
    {"name": "pu", "lines": ["1","2"], "cursor": [1,1], "keys": "yy:2pu<CR>", "expect": {"cursor":[3,1],"lines":["1","2","1"],"registers":{"\"":["1\n","V"],"0":["1\n","V"],":":["2pu","v"]}}},
    {"name": "pu bang", "lines": ["1","2"], "cursor": [2,1], "keys": "yy:pu!<CR>", "expect": {"cursor":[2,1],"lines":["1","2","2"],"registers":{"\"":["2\n","V"],"0":["2\n","V"],":":["pu!","v"]}}},
    {"name": "pu a charwise register", "lines": ["foo bar"], "cursor": [1,1], "keys": "yiw:pu<CR>", "expect": {"cursor":[2,1],"lines":["foo bar","foo"],"registers":{"\"":["foo","v"],"0":["foo","v"],":":["pu","v"]}}},
    {"name": "pu to line 0", "lines": ["1","2"], "cursor": [2,1], "keys": "yy:0pu<CR>", "expect": {"cursor":[1,1],"lines":["2","1","2"],"registers":{"\"":["2\n","V"],"0":["2\n","V"],":":["0pu","v"]}}},
    {"name": "m down", "lines": ["1","2","3","4"], "cursor": [1,1], "keys": ":m2<CR>", "expect": {"cursor":[2,1],"lines":["2","1","3","4"],"registers":{":":["m2","v"]}}},
    {"name": "m to the end", "lines": ["1","2","3","4"], "cursor": [1,1], "keys": ":1,2m$<CR>", "expect": {"cursor":[4,1],"lines":["3","4","1","2"],"registers":{":":["1,2m$","v"]}}},
    {"name": "m up", "lines": ["1","2","3","4"], "cursor": [4,1], "keys": ":m0<CR>", "expect": {"cursor":[1,1],"lines":["4","1","2","3"],"registers":{":":["m0","v"]}}},
    {"name": "m minus 2", "lines": ["1","2","3","4"], "cursor": [3,1], "keys": ":m-2<CR>", "expect": {"cursor":[2,1],"lines":["1","3","2","4"],"registers":{":":["m-2","v"]}}},
    {"name": "m into itself fails", "lines": ["1","2","3","4"], "cursor": [1,1], "keys": ":1,3m2<CR>", "expect": {"cursor":[1,1],"lines":["1","2","3","4"],"registers":{":":["1,3m2","v"]}}},
    {"name": "t copies", "lines": ["1","2","3"], "cursor": [1,1], "keys": ":t$<CR>", "expect": {"cursor":[4,1],"lines":["1","2","3","1"],"registers":{":":["t$","v"]}}},
    {"name": "co copies a range", "lines": ["1","2","3"], "cursor": [1,1], "keys": ":1,2co0<CR>", "expect": {"cursor":[2,1],"lines":["1","2","1","2","3"],"registers":{":":["1,2co0","v"]}}},
    {"name": "t dot", "lines": ["  a","b"], "cursor": [1,1], "keys": ":t.<CR>", "expect": {"cursor":[2,3],"lines":["  a","  a","b"],"registers":{":":["t.","v"]}}},
    {"name": "j joins", "lines": ["a","  b","c"], "cursor": [1,1], "keys": ":j<CR>", "expect": {"cursor":[1,1],"lines":["a b","c"],"registers":{":":["j","v"]}}},
    {"name": "j range", "lines": ["a","b","c","d"], "cursor": [1,1], "keys": ":1,3j<CR>", "expect": {"cursor":[1,1],"lines":["a b c","d"],"registers":{":":["1,3j","v"]}}},
    {"name": "j bang", "lines": ["a","  b"], "cursor": [1,1], "keys": ":j!<CR>", "expect": {"cursor":[1,1],"lines":["a  b"],"registers":{":":["j!","v"]}}},
    {"name": "j count", "lines": ["a","b","c","d"], "cursor": [1,1], "keys": ":j 3<CR>", "expect": {"cursor":[1,1],"lines":["a b c","d"],"registers":{":":["j 3","v"]}}},
    {"name": "shift right", "lines": ["a","b"], "cursor": [1,1], "set": "sw=2 et", "keys": ":%><CR>", "expect": {"cursor":[2,3],"lines":["  a","  b"],"registers":{":":["%>","v"]}}},
    {"name": "shift twice", "lines": ["a","b"], "cursor": [1,1], "set": "sw=2 et", "keys": ":>><CR>", "expect": {"cursor":[1,5],"lines":["    a","b"],"registers":{":":[">>","v"]}}},
    {"name": "shift left with count", "lines": ["    a","    b","    c"], "cursor": [1,1], "set": "sw=2 et", "keys": ":< 2<CR>", "expect": {"cursor":[2,3],"lines":["  a","  b","    c"],"registers":{":":["< 2","v"]}}},
    {"name": "k sets a mark", "lines": ["1","2","3"], "cursor": [1,1], "keys": ":3ka<CR>'a", "expect": {"cursor":[3,1],"lines":["1","2","3"],"registers":{":":["3ka","v"]}}},
    {"name": "mark command", "lines": ["1","2","3"], "cursor": [1,1], "keys": ":2mark b<CR>'b", "expect": {"cursor":[2,1],"lines":["1","2","3"],"registers":{":":["2mark b","v"]}}},
    {"name": "mark range", "lines": ["1","2","3","4"], "cursor": [2,1], "keys": "majmb:'a,'bd<CR>", "expect": {"cursor":[2,1],"lines":["1","4"],"registers":{"\"":["2\n3\n","V"],"1":["2\n3\n","V"],":":["'a,'bd","v"]}}},
    {"name": "search range", "lines": ["a","start","x","end","b"], "cursor": [1,1], "keys": ":/start/,/end/d<CR>", "expect": {"cursor":[2,1],"lines":["a","b"],"registers":{"\"":["start\nx\nend\n","V"],"/":["end","v"],"1":["start\nx\nend\n","V"],":":["/start/,/end/d","v"]}}},
    {"name": "search range with offset", "lines": ["a","start","x","y"], "cursor": [1,1], "keys": ":/start/+1d<CR>", "expect": {"cursor":[3,1],"lines":["a","start","y"],"registers":{"\"":["x\n","V"],"/":["start","v"],"1":["x\n","V"],":":["/start/+1d","v"]}}},
    {"name": "semicolon range", "lines": ["a","b","c","d","e"], "cursor": [1,1], "keys": ":2;+1d<CR>", "expect": {"cursor":[2,1],"lines":["a","d","e"],"registers":{"\"":["b\nc\n","V"],"1":["b\nc\n","V"],":":["2;+1d","v"]}}},
    {"name": "goto line", "lines": ["a","  b","c"], "cursor": [1,1], "keys": ":2<CR>", "expect": {"cursor":[2,3],"lines":["a","  b","c"],"registers":{":":["2","v"]}}},
    {"name": "goto past the end", "lines": ["a","b","  c"], "cursor": [1,1], "keys": ":99<CR>", "expect": {"cursor":[1,1],"lines":["a","b","  c"],"registers":{":":["99","v"]}}},
    {"name": "goto dollar", "lines": ["a","b","  c"], "cursor": [1,1], "keys": ":$<CR>", "expect": {"cursor":[3,3],"lines":["a","b","  c"],"registers":{":":["$","v"]}}},
    {"name": "goto relative", "lines": ["a","b","c","d"], "cursor": [1,1], "keys": ":+2<CR>", "expect": {"cursor":[3,1],"lines":["a","b","c","d"],"registers":{":":["+2","v"]}}},
    {"name": "goto is a jump", "lines": ["a","b","c","d"], "cursor": [1,1], "keys": ":4<CR>''", "expect": {"cursor":[1,1],"lines":["a","b","c","d"],"registers":{":":["4","v"]}}},
    {"name": "undo command", "lines": ["abc"], "cursor": [1,1], "keys": "x:u<CR>", "expect": {"cursor":[1,1],"lines":["abc"],"registers":{"\"":["a","v"],"-":["a","v"],":":["u","v"]}}},
    {"name": "redo command", "lines": ["abc"], "cursor": [1,1], "keys": "xu:red<CR>", "expect": {"cursor":[1,1],"lines":["bc"],"registers":{"\"":["a","v"],"-":["a","v"],":":["red","v"]}}},
    {"name": "set sw then shift", "lines": ["a"], "cursor": [1,1], "keys": ":set sw=3 et<CR>>>", "expect": {"cursor":[1,4],"lines":["   a"],"registers":{":":["set sw=3 et","v"]}}},
    {"name": "set ignorecase then search", "lines": ["x FOO"], "cursor": [1,1], "keys": ":set ic<CR>/foo<CR>", "expect": {"cursor":[1,3],"lines":["x FOO"],"registers":{"/":["foo","v"],":":["set ic","v"]}}},
    {"name": "noh is accepted", "lines": ["abc"], "cursor": [1,2], "keys": ":noh<CR>x", "expect": {"cursor":[1,2],"lines":["ac"],"registers":{"\"":["b","v"],"-":["b","v"],":":["noh","v"]}}},
    {"name": "backwards range fails", "lines": ["a","b","c"], "cursor": [1,1], "keys": ":3,1d<CR>", "expect": {"cursor":[1,1],"lines":["a","b","c"],"registers":{":":["3,1d","v"]}}},
    {"name": "invalid range fails", "lines": ["a","b"], "cursor": [1,1], "keys": ":5d<CR>", "expect": {"cursor":[1,1],"lines":["a","b"],"registers":{":":["5d","v"]}}},
    {"name": "escape cancels the command line", "lines": ["abc"], "cursor": [1,1], "keys": ":s/a/b/<Esc>", "expect": {"cursor":[1,1],"lines":["abc"],"registers":{}}},
    {"name": "s with a mark range", "lines": ["a","a","a"], "cursor": [1,1], "keys": "jma:'a,$s/a/b/<CR>", "expect": {"cursor":[3,1],"lines":["a","b","b"],"registers":{"/":["a","v"],":":["'a,$s/a/b/","v"]}}},
    {"name": "g with visual range", "lines": ["x","x","x","x"], "cursor": [2,1], "keys": "Vj:g/x/d<CR>", "expect": {"cursor":[2,1],"lines":["x","x"],"registers":{"\"":["x\n","V"],"/":["x","v"],"1":["x\n","V"],"2":["x\n","V"],":":["'<,'>g/x/d","v"]}}}
  ]
}
