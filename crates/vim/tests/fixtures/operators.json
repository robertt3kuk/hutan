    {"name": "yw then P", "lines": ["foo bar"], "cursor": [1,1], "keys": "ywP", "expect": {"cursor":[1,4],"lines":["foo foo bar"],"registers":{"\"":["foo ","v"],"0":["foo ","v"]}}},
