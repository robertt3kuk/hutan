    {"name": "2D", "lines": ["abc def","ghi","jkl"], "cursor": [1,3], "keys": "2D", "expect": {"cursor":[1,2],"lines":["ab","jkl"],"registers":{"\"":["c def\nghi","v"],"1":["c def\nghi","v"]}}},
    {"name": "cw on a word", "lines": ["foo bar"], "cursor": [1,1], "keys": "cwX<Esc>", "expect": {"cursor":[1,1],"lines":["X bar"],"registers":{"\"":["foo","v"],"-":["foo","v"],".":["X","v"]}}},
    {"name": "cw on blanks", "lines": ["foo   bar"], "cursor": [1,4], "keys": "cwX<Esc>", "expect": {"cursor":[1,4],"lines":["fooXbar"],"registers":{"\"":["   ","v"],"-":["   ","v"],".":["X","v"]}}},
    {"name": "c2w", "lines": ["a b c d"], "cursor": [1,1], "keys": "c2wX<Esc>", "expect": {"cursor":[1,1],"lines":["X c d"],"registers":{"\"":["a b","v"],"-":["a b","v"],".":["X","v"]}}},
    {"name": "cc keeps an empty line", "lines": ["one","  two","three"], "cursor": [2,3], "keys": "ccnew<Esc>", "expect": {"cursor":[2,3],"lines":["one","new","three"],"registers":{"\"":["  two\n","V"],".":["new","v"],"1":["  two\n","V"]}}},
    {"name": "C", "lines": ["abc def"], "cursor": [1,4], "keys": "Cxyz<Esc>", "expect": {"cursor":[1,6],"lines":["abcxyz"],"registers":{"\"":[" def","v"],"-":[" def","v"],".":["xyz","v"]}}},
    {"name": "s", "lines": ["abcdef"], "cursor": [1,2], "keys": "2sXY<Esc>", "expect": {"cursor":[1,3],"lines":["aXYdef"],"registers":{"\"":["bc","v"],"-":["bc","v"],".":["XY","v"]}}},
