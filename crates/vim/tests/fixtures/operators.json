    {"name": "dot repeats with a new count", "lines": ["a b c d e f"], "cursor": [1,1], "keys": "dw2.", "expect": {"cursor":[1,1],"lines":["d e f"],"registers":{"\"":["b c ","v"],"-":["b c ","v"]}}},
