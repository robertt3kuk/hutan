    {"name": "df", "lines": ["one(two)three"], "cursor": [1,1], "keys": "df(", "expect": {"cursor":[1,1],"lines":["two)three"],"registers":{"\"":["one(","v"],"-":["one(","v"]}}},
    {"name": "dt", "lines": ["one(two)three"], "cursor": [1,1], "keys": "dt)", "expect": {"cursor":[1,1],"lines":[")three"],"registers":{"\"":["one(two","v"],"-":["one(two","v"]}}},
    {"name": "dF", "lines": ["one(two)three"], "cursor": [1,10], "keys": "dF(", "expect": {"cursor":[1,4],"lines":["onehree"],"registers":{"\"":["(two)t","v"],"-":["(two)t","v"]}}},
    {"name": "dT", "lines": ["one(two)three"], "cursor": [1,10], "keys": "dT(", "expect": {"cursor":[1,5],"lines":["one(hree"],"registers":{"\"":["two)t","v"],"-":["two)t","v"]}}},
    {"name": "d percent", "lines": ["x = (a + (b)) + c"], "cursor": [1,5], "keys": "d%", "expect": {"cursor":[1,5],"lines":["x =  + c"],"registers":{"\"":["(a + (b))","v"],"-":["(a + (b))","v"],"1":["(a + (b))","v"]}}},
    {"name": "x with a count", "lines": ["abcdef"], "cursor": [1,2], "keys": "3x", "expect": {"cursor":[1,2],"lines":["aef"],"registers":{"\"":["bcd","v"],"-":["bcd","v"]}}},
    {"name": "x at the end of a line", "lines": ["abc"], "cursor": [1,3], "keys": "x", "expect": {"cursor":[1,2],"lines":["ab"],"registers":{"\"":["c","v"],"-":["c","v"]}}},
    {"name": "x past the end", "lines": ["abcdef"], "cursor": [1,5], "keys": "9x", "expect": {"cursor":[1,4],"lines":["abcd"],"registers":{"\"":["ef","v"],"-":["ef","v"]}}},
    {"name": "X", "lines": ["abcdef"], "cursor": [1,4], "keys": "2X", "expect": {"cursor":[1,2],"lines":["adef"],"registers":{"\"":["bc","v"],"-":["bc","v"]}}},
