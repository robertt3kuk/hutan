    {"name": "indent a block", "lines": ["int f() {","x;","if (a) {","y;","}","}"], "cursor": [1,1], "set": "sw=4 et", "keys": "=G", "expect": {"cursor":[1,1],"lines":["int f() {","    x;","    if (a) {","        y;","    }","}"],"registers":{}}},
    {"name": "indent one line", "lines": ["if (a) {","        x;","}"], "cursor": [2,1], "set": "sw=2 et", "keys": "==", "expect": {"cursor":[2,3],"lines":["if (a) {","  x;","}"],"registers":{}}},
    {"name": "g tilde w", "lines": ["foo Bar"], "cursor": [1,1], "keys": "g~w", "expect": {"cursor":[1,1],"lines":["FOO Bar"],"registers":{}}},
