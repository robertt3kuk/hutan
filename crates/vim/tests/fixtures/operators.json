    {"name": "shift skips empty lines", "lines": ["a","","c"], "cursor": [1,1], "set": "sw=2 et", "keys": ">2j", "expect": {"cursor":[1,3],"lines":["  a","","  c"],"registers":{}}},
    {"name": "shift round", "lines": ["   abc"], "cursor": [1,1], "set": "sw=4 et sr", "keys": ">>", "expect": {"cursor":[1,5],"lines":["    abc"],"registers":{}}},
