{
  "vim": "VIM - Vi IMproved 9.1, patches 1-1752 (/usr/bin/vim -Nu NONE -i NONE -es)",
  "cases": [
    {"name": "dw", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "dw", "expect": {"cursor":[1,1],"lines":["bar baz"],"registers":{"\"":["foo ","v"],"-":["foo ","v"]}}},
    {"name": "dw on the last word of a line", "lines": ["foo bar","baz"], "cursor": [1,5], "keys": "dw", "expect": {"cursor":[1,4],"lines":["foo ","baz"],"registers":{"\"":["bar","v"],"-":["bar","v"]}}},
    {"name": "d2w across a line", "lines": ["a b","c d"], "cursor": [1,1], "keys": "d2w", "expect": {"cursor":[1,1],"lines":["","c d"],"registers":{"\"":["a b","v"],"-":["a b","v"]}}},
    {"name": "2dw", "lines": ["a b c d e"], "cursor": [1,3], "keys": "2dw", "expect": {"cursor":[1,3],"lines":["a d e"],"registers":{"\"":["b c ","v"],"-":["b c ","v"]}}},
    {"name": "de", "lines": ["foo bar baz"], "cursor": [1,2], "keys": "de", "expect": {"cursor":[1,2],"lines":["f bar baz"],"registers":{"\"":["oo","v"],"-":["oo","v"]}}},
    {"name": "db", "lines": ["foo bar baz"], "cursor": [1,6], "keys": "db", "expect": {"cursor":[1,5],"lines":["foo ar baz"],"registers":{"\"":["b","v"],"-":["b","v"]}}},
    {"name": "dge", "lines": ["foo bar baz"], "cursor": [1,6], "keys": "dge", "expect": {"cursor":[1,3],"lines":["for baz"],"registers":{"\"":["o ba","v"],"-":["o ba","v"]}}},
    {"name": "d dollar", "lines": ["foo bar baz"], "cursor": [1,5], "keys": "d$", "expect": {"cursor":[1,4],"lines":["foo "],"registers":{"\"":["bar baz","v"],"-":["bar baz","v"]}}},
    {"name": "d0", "lines": ["foo bar baz"], "cursor": [1,5], "keys": "d0", "expect": {"cursor":[1,1],"lines":["bar baz"],"registers":{"\"":["foo ","v"],"-":["foo ","v"]}}},
    {"name": "d caret", "lines": ["   foo bar"], "cursor": [1,8], "keys": "d^", "expect": {"cursor":[1,4],"lines":["   bar"],"registers":{"\"":["foo ","v"],"-":["foo ","v"]}}},
    {"name": "dd in the middle", "lines": ["one","  two","three"], "cursor": [2,4], "keys": "dd", "expect": {"cursor":[2,1],"lines":["one","three"],"registers":{"\"":["  two\n","V"],"1":["  two\n","V"]}}},
    {"name": "dd on the last line", "lines": ["one","two","  three"], "cursor": [3,3], "keys": "dd", "expect": {"cursor":[2,1],"lines":["one","two"],"registers":{"\"":["  three\n","V"],"1":["  three\n","V"]}}},
    {"name": "3dd", "lines": ["1","2","3","4","5"], "cursor": [2,1], "keys": "3dd", "expect": {"cursor":[2,1],"lines":["1","5"],"registers":{"\"":["2\n3\n4\n","V"],"1":["2\n3\n4\n","V"]}}},
    {"name": "2dd on the last line fails", "lines": ["1","2","3"], "cursor": [3,1], "keys": "2dd", "expect": {"cursor":[3,1],"lines":["1","2","3"],"registers":{}}},
    {"name": "5dd past the end deletes to the end", "lines": ["1","2","3","4"], "cursor": [2,1], "keys": "5dd", "expect": {"cursor":[1,1],"lines":["1"],"registers":{"\"":["2\n3\n4\n","V"],"1":["2\n3\n4\n","V"]}}},
    {"name": "dj", "lines": ["1","2","3","4"], "cursor": [2,1], "keys": "dj", "expect": {"cursor":[2,1],"lines":["1","4"],"registers":{"\"":["2\n3\n","V"],"1":["2\n3\n","V"]}}},
    {"name": "dk", "lines": ["1","2","3","4"], "cursor": [3,1], "keys": "dk", "expect": {"cursor":[2,1],"lines":["1","4"],"registers":{"\"":["2\n3\n","V"],"1":["2\n3\n","V"]}}},
    {"name": "dG", "lines": ["1","2","3","4"], "cursor": [2,1], "keys": "dG", "expect": {"cursor":[1,1],"lines":["1"],"registers":{"\"":["2\n3\n4\n","V"],"1":["2\n3\n4\n","V"]}}},
    {"name": "dgg", "lines": ["1","2","3","4"], "cursor": [3,1], "keys": "dgg", "expect": {"cursor":[1,1],"lines":["4"],"registers":{"\"":["1\n2\n3\n","V"],"1":["1\n2\n3\n","V"]}}},
    {"name": "d brace from the line start is linewise", "lines": ["a","b","","c"], "cursor": [1,1], "keys": "d}", "expect": {"cursor":[1,1],"lines":["","c"],"registers":{"\"":["a\nb\n","V"],"1":["a\nb\n","V"]}}},
