{
  "vim": "VIM - Vi IMproved 9.1, patches 1-1752 (/usr/bin/vim -Nu NONE -i NONE -es)",
  "cases": [
    {"name": "CTRL-A after the caret", "lines": ["x 7 y"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,3],"lines":["x 8 y"],"registers":{}}},
    {"name": "5 CTRL-A", "lines": ["x 7 y"], "cursor": [1,1], "keys": "5<C-a>", "expect": {"cursor":[1,4],"lines":["x 12 y"],"registers":{}}},
    {"name": "CTRL-X to negative", "lines": ["x 3"], "cursor": [1,1], "keys": "5<C-x>", "expect": {"cursor":[1,4],"lines":["x -2"],"registers":{}}},
    {"name": "CTRL-A on a negative", "lines": ["a -5 b"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,4],"lines":["a -4 b"],"registers":{}}},
    {"name": "CTRL-A on the minus", "lines": ["a -5 b"], "cursor": [1,3], "keys": "<C-a>", "expect": {"cursor":[1,4],"lines":["a -4 b"],"registers":{}}},
    {"name": "CTRL-A to zero", "lines": ["-1"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,1],"lines":["0"],"registers":{}}},
    {"name": "CTRL-A word-minus", "lines": ["x-1"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,2],"lines":["x0"],"registers":{}}},
    {"name": "CTRL-A hex", "lines": ["0x0f"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,4],"lines":["0x10"],"registers":{}}},
    {"name": "CTRL-A hex upper", "lines": ["0xFF"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,5],"lines":["0x100"],"registers":{}}},
    {"name": "CTRL-A hex keeps the width", "lines": ["0x00ff"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,6],"lines":["0x0100"],"registers":{}}},
    {"name": "CTRL-X hex below zero", "lines": ["0x00"], "cursor": [1,1], "keys": "<C-x>", "expect": {"cursor":[1,18],"lines":["0xffffffffffffffff"],"registers":{}}},
    {"name": "CTRL-A caret on the x of hex", "lines": ["0x1f"], "cursor": [1,2], "keys": "<C-a>", "expect": {"cursor":[1,4],"lines":["0x20"],"registers":{}}},
    {"name": "CTRL-A caret inside hex", "lines": ["ab 0x1f"], "cursor": [1,6], "keys": "<C-a>", "expect": {"cursor":[1,7],"lines":["ab 0x20"],"registers":{}}},
    {"name": "CTRL-A in a word", "lines": ["foo9bar"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,5],"lines":["foo10bar"],"registers":{}}},
    {"name": "CTRL-A no number", "lines": ["abc"], "cursor": [1,1], "keys": "<C-a>x", "expect": {"cursor":[1,1],"lines":["bc"],"registers":{"\"":["a","v"],"-":["a","v"]}}},
    {"name": "CTRL-A number before the caret only", "lines": ["12 abc"], "cursor": [1,5], "keys": "<C-a>x", "expect": {"cursor":[1,5],"lines":["12 ac"],"registers":{"\"":["b","v"],"-":["b","v"]}}},
    {"name": "CTRL-A caret in the number", "lines": ["123 4"], "cursor": [1,2], "keys": "<C-a>", "expect": {"cursor":[1,3],"lines":["124 4"],"registers":{}}},
    {"name": "CTRL-A grows the number", "lines": ["99"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,3],"lines":["100"],"registers":{}}},
    {"name": "CTRL-X shrinks the number", "lines": ["100 x"], "cursor": [1,1], "keys": "<C-x>", "expect": {"cursor":[1,2],"lines":["99 x"],"registers":{}}},
    {"name": "2 CTRL-X across zero", "lines": ["1"], "cursor": [1,1], "keys": "2<C-x>", "expect": {"cursor":[1,2],"lines":["-1"],"registers":{}}},
    {"name": "CTRL-A leading zeros", "lines": ["007"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,3],"lines":["010"],"registers":{}}},
    {"name": "CTRL-A decimal leading zero 9", "lines": ["09"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,2],"lines":["10"],"registers":{}}},
    {"name": "CTRL-A binary", "lines": ["0b101"], "cursor": [1,1], "keys": "<C-a>", "expect": {"cursor":[1,5],"lines":["0b110"],"registers":{}}},
    {"name": "CTRL-A and dot", "lines": ["5"], "cursor": [1,1], "keys": "<C-a>.", "expect": {"cursor":[1,1],"lines":["7"],"registers":{}}},
    {"name": "3 CTRL-A and dot", "lines": ["5"], "cursor": [1,1], "keys": "3<C-a>.", "expect": {"cursor":[1,2],"lines":["11"],"registers":{}}},
    {"name": "CTRL-A undo", "lines": ["5"], "cursor": [1,1], "keys": "<C-a><C-a>u", "expect": {"cursor":[1,1],"lines":["6"],"registers":{}}},
    {"name": "Visual CTRL-A every line", "lines": ["1","1","1"], "cursor": [1,1], "keys": "VG<C-a>", "expect": {"cursor":[1,1],"lines":["2","2","2"],"registers":{}}},
    {"name": "Visual g CTRL-A", "lines": ["0","0","0"], "cursor": [1,1], "keys": "VGg<C-a>", "expect": {"cursor":[1,1],"lines":["1","2","3"],"registers":{}}},
    {"name": "Visual 2 g CTRL-A", "lines": ["0","0","0"], "cursor": [1,1], "keys": "VG2g<C-a>", "expect": {"cursor":[1,1],"lines":["2","4","6"],"registers":{}}},
    {"name": "Visual g CTRL-X", "lines": ["10","10","10"], "cursor": [1,1], "keys": "VGg<C-x>", "expect": {"cursor":[1,1],"lines":["9","8","7"],"registers":{}}},
    {"name": "Visual CTRL-X first number only", "lines": ["5 x 5"], "cursor": [1,1], "keys": "v$<C-x>", "expect": {"cursor":[1,1],"lines":["4 x 5"],"registers":{}}},
    {"name": "Visual CTRL-A inside the selection", "lines": ["12 34 56"], "cursor": [1,4], "keys": "vl<C-a>", "expect": {"cursor":[1,4],"lines":["12 35 56"],"registers":{}}},
    {"name": "Visual CTRL-A part of a number", "lines": ["1234"], "cursor": [1,3], "keys": "vl<C-a>", "expect": {"cursor":[1,3],"lines":["1235"],"registers":{}}},
    {"name": "Visual CTRL-A minus outside", "lines": ["-5"], "cursor": [1,2], "keys": "v<C-a>", "expect": {"cursor":[1,2],"lines":["-6"],"registers":{}}},
    {"name": "Visual CTRL-A skips lines without a number", "lines": ["1","x","1"], "cursor": [1,1], "keys": "VGg<C-a>", "expect": {"cursor":[1,1],"lines":["2","x","3"],"registers":{}}},
    {"name": "Visual block CTRL-A", "lines": ["a1 1","a1 1"], "cursor": [1,4], "keys": "<C-v>j<C-a>", "expect": {"cursor":[1,4],"lines":["a1 2","a1 2"],"registers":{}}},
    {"name": "Visual CTRL-A and dot", "lines": ["1","1"], "cursor": [1,1], "keys": "Vj<C-a>.", "expect": {"cursor":[1,1],"lines":["3","3"],"registers":{}}},
    {"name": "Visual CTRL-A hex", "lines": ["0x0f","0x0f"], "cursor": [1,1], "keys": "Vjg<C-a>", "expect": {"cursor":[1,1],"lines":["0x10","0x11"],"registers":{}}}
  ]
}
