{
  "vim": "VIM - Vi IMproved 9.1, patches 1-1752 (/usr/bin/vim -Nu NONE -i NONE -es)",
  "cases": [
    {"name": "v e d", "lines": ["foo bar baz"], "cursor": [1,5], "keys": "ved", "expect": {"cursor":[1,5],"lines":["foo  baz"],"registers":{"\"":["bar","v"],"-":["bar","v"]}}},
