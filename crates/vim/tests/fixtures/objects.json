{
  "vim": "VIM - Vi IMproved 9.1, patches 1-1752 (/usr/bin/vim -Nu NONE -i NONE -es)",
  "cases": [
    {"name": "diw", "lines": ["foo bar baz"], "cursor": [1,6], "keys": "diw", "expect": {"cursor":[1,5],"lines":["foo  baz"],"registers":{"\"":["bar","v"],"-":["bar","v"]}}},
    {"name": "daw", "lines": ["foo bar baz"], "cursor": [1,6], "keys": "daw", "expect": {"cursor":[1,5],"lines":["foo baz"],"registers":{"\"":["bar ","v"],"-":["bar ","v"]}}},
    {"name": "daw on the last word takes the blank before", "lines": ["foo bar baz"], "cursor": [1,10], "keys": "daw", "expect": {"cursor":[1,7],"lines":["foo bar"],"registers":{"\"":[" baz","v"],"-":[" baz","v"]}}},
    {"name": "diw on blanks", "lines": ["foo   bar"], "cursor": [1,5], "keys": "diw", "expect": {"cursor":[1,4],"lines":["foobar"],"registers":{"\"":["   ","v"],"-":["   ","v"]}}},
    {"name": "daw on blanks", "lines": ["foo   bar baz"], "cursor": [1,5], "keys": "daw", "expect": {"cursor":[1,4],"lines":["foo baz"],"registers":{"\"":["   bar","v"],"-":["   bar","v"]}}},
    {"name": "d2aw", "lines": ["a b c d"], "cursor": [1,1], "keys": "d2aw", "expect": {"cursor":[1,1],"lines":["c d"],"registers":{"\"":["a b ","v"],"-":["a b ","v"]}}},
    {"name": "d3iw", "lines": ["a b c d"], "cursor": [1,1], "keys": "d3iw", "expect": {"cursor":[1,1],"lines":[" c d"],"registers":{"\"":["a b","v"],"-":["a b","v"]}}},
    {"name": "ciw on punctuation", "lines": ["foo.bar"], "cursor": [1,4], "keys": "ciwX<Esc>", "expect": {"cursor":[1,4],"lines":["fooXbar"],"registers":{"\"":[".","v"],"-":[".","v"],".":["X","v"]}}},
    {"name": "diW", "lines": ["foo.bar baz"], "cursor": [1,2], "keys": "diW", "expect": {"cursor":[1,1],"lines":[" baz"],"registers":{"\"":["foo.bar","v"],"-":["foo.bar","v"]}}},
    {"name": "daW", "lines": ["x foo.bar baz"], "cursor": [1,4], "keys": "daW", "expect": {"cursor":[1,3],"lines":["x baz"],"registers":{"\"":["foo.bar ","v"],"-":["foo.bar ","v"]}}},
    {"name": "yiw", "lines": ["foo bar"], "cursor": [1,6], "keys": "yiw", "expect": {"cursor":[1,5],"lines":["foo bar"],"registers":{"\"":["bar","v"],"0":["bar","v"]}}},
    {"name": "di paren", "lines": ["f(a, (b), c)"], "cursor": [1,4], "keys": "di(", "expect": {"cursor":[1,3],"lines":["f()"],"registers":{"\"":["a, (b), c","v"],"-":["a, (b), c","v"]}}},
    {"name": "da paren", "lines": ["f(a, (b), c) x"], "cursor": [1,4], "keys": "da(", "expect": {"cursor":[1,2],"lines":["f x"],"registers":{"\"":["(a, (b), c)","v"],"-":["(a, (b), c)","v"]}}},
    {"name": "dib nested", "lines": ["f(a, (b), c)"], "cursor": [1,7], "keys": "dib", "expect": {"cursor":[1,7],"lines":["f(a, (), c)"],"registers":{"\"":["b","v"],"-":["b","v"]}}},
    {"name": "d2i paren", "lines": ["f(a, (b), c)"], "cursor": [1,7], "keys": "d2i(", "expect": {"cursor":[1,3],"lines":["f()"],"registers":{"\"":["a, (b), c","v"],"-":["a, (b), c","v"]}}},
    {"name": "di paren on the open paren", "lines": ["f(abc)"], "cursor": [1,2], "keys": "di(", "expect": {"cursor":[1,3],"lines":["f()"],"registers":{"\"":["abc","v"],"-":["abc","v"]}}},
    {"name": "di paren on the close paren", "lines": ["f(abc)"], "cursor": [1,6], "keys": "di)", "expect": {"cursor":[1,3],"lines":["f()"],"registers":{"\"":["abc","v"],"-":["abc","v"]}}},
    {"name": "di paren empty", "lines": ["f() x"], "cursor": [1,2], "keys": "di(", "expect": {"cursor":[1,3],"lines":["f() x"],"registers":{}}},
    {"name": "di brace over lines", "lines": ["if (x) {","    foo;","    bar;","}"], "cursor": [2,5], "keys": "di{", "expect": {"cursor":[2,1],"lines":["if (x) {","}"],"registers":{"\"":["    foo;\n    bar;\n","V"],"1":["    foo;\n    bar;\n","V"]}}},
    {"name": "ci brace over lines", "lines": ["if (x) {","    foo;","}"], "cursor": [2,5], "keys": "ci{z<Esc>", "expect": {"cursor":[2,1],"lines":["if (x) {","z","}"],"registers":{"\"":["    foo;\n","V"],".":["z","v"],"1":["    foo;\n","V"]}}},
    {"name": "da brace", "lines": ["x = {a: 1};"], "cursor": [1,7], "keys": "da{", "expect": {"cursor":[1,5],"lines":["x = ;"],"registers":{"\"":["{a: 1}","v"],"-":["{a: 1}","v"]}}},
    {"name": "diB", "lines": ["x = {a: 1};"], "cursor": [1,7], "keys": "diB", "expect": {"cursor":[1,6],"lines":["x = {};"],"registers":{"\"":["a: 1","v"],"-":["a: 1","v"]}}},
    {"name": "di bracket", "lines": ["arr[1 + 2]"], "cursor": [1,6], "keys": "di[", "expect": {"cursor":[1,5],"lines":["arr[]"],"registers":{"\"":["1 + 2","v"],"-":["1 + 2","v"]}}},
    {"name": "da bracket", "lines": ["arr[1 + 2] x"], "cursor": [1,6], "keys": "da]", "expect": {"cursor":[1,4],"lines":["arr x"],"registers":{"\"":["[1 + 2]","v"],"-":["[1 + 2]","v"]}}},
    {"name": "di angle", "lines": ["Vec<String> v"], "cursor": [1,6], "keys": "di<", "expect": {"cursor":[1,5],"lines":["Vec<> v"],"registers":{"\"":["String","v"],"-":["String","v"]}}},
    {"name": "da angle", "lines": ["Vec<String> v"], "cursor": [1,6], "keys": "da>", "expect": {"cursor":[1,4],"lines":["Vec v"],"registers":{"\"":["<String>","v"],"-":["<String>","v"]}}},
    {"name": "di paren fails outside", "lines": ["no parens here"], "cursor": [1,4], "keys": "di(", "expect": {"cursor":[1,4],"lines":["no parens here"],"registers":{}}},
    {"name": "di quote", "lines": ["say \"hello world\" now"], "cursor": [1,8], "keys": "di\"", "expect": {"cursor":[1,6],"lines":["say \"\" now"],"registers":{"\"":["hello world","v"],"-":["hello world","v"]}}},
    {"name": "da quote takes the blank after", "lines": ["say \"hello world\" now"], "cursor": [1,8], "keys": "da\"", "expect": {"cursor":[1,5],"lines":["say now"],"registers":{"\"":["\"hello world\" ","v"],"-":["\"hello world\" ","v"]}}},
    {"name": "da quote at the end takes the blank before", "lines": ["say \"hello\""], "cursor": [1,8], "keys": "da\"", "expect": {"cursor":[1,3],"lines":["say"],"registers":{"\"":[" \"hello\"","v"],"-":[" \"hello\"","v"]}}},
    {"name": "di quote before the string", "lines": ["x = \"abc\""], "cursor": [1,1], "keys": "di\"", "expect": {"cursor":[1,6],"lines":["x = \"\""],"registers":{"\"":["abc","v"],"-":["abc","v"]}}},
    {"name": "di quote on the opening quote", "lines": ["a \"b c\" d"], "cursor": [1,3], "keys": "di\"", "expect": {"cursor":[1,4],"lines":["a \"\" d"],"registers":{"\"":["b c","v"],"-":["b c","v"]}}},
    {"name": "di quote on the closing quote", "lines": ["a \"b c\" d"], "cursor": [1,7], "keys": "di\"", "expect": {"cursor":[1,4],"lines":["a \"\" d"],"registers":{"\"":["b c","v"],"-":["b c","v"]}}},
    {"name": "di quote with an escaped quote", "lines": ["x \"a\\\"b\" y"], "cursor": [1,4], "keys": "di\"", "expect": {"cursor":[1,4],"lines":["x \"\" y"],"registers":{"\"":["a\\\"b","v"],"-":["a\\\"b","v"]}}},
    {"name": "ci single quote", "lines": ["let s = 'old';"], "cursor": [1,11], "keys": "ci'new<Esc>", "expect": {"cursor":[1,12],"lines":["let s = 'new';"],"registers":{"\"":["old","v"],"-":["old","v"],".":["new","v"]}}},
    {"name": "di backtick", "lines": ["run `cmd arg` now"], "cursor": [1,7], "keys": "di`", "expect": {"cursor":[1,6],"lines":["run `` now"],"registers":{"\"":["cmd arg","v"],"-":["cmd arg","v"]}}},
    {"name": "d2i quote takes the quotes", "lines": ["say \"hello\" now"], "cursor": [1,8], "keys": "d2i\"", "expect": {"cursor":[1,5],"lines":["say  now"],"registers":{"\"":["\"hello\"","v"],"-":["\"hello\"","v"]}}},
    {"name": "yi quote", "lines": ["say \"hello\" now"], "cursor": [1,8], "keys": "yi\"", "expect": {"cursor":[1,6],"lines":["say \"hello\" now"],"registers":{"\"":["hello","v"],"0":["hello","v"]}}},
    {"name": "dip", "lines": ["a","b","","c","d"], "cursor": [1,1], "keys": "dip", "expect": {"cursor":[1,1],"lines":["","c","d"],"registers":{"\"":["a\nb\n","V"],"1":["a\nb\n","V"]}}},
    {"name": "dap", "lines": ["a","b","","c","d"], "cursor": [1,1], "keys": "dap", "expect": {"cursor":[1,1],"lines":["c","d"],"registers":{"\"":["a\nb\n\n","V"],"1":["a\nb\n\n","V"]}}},
    {"name": "dap on the last paragraph", "lines": ["a","","c","d"], "cursor": [3,1], "keys": "dap", "expect": {"cursor":[1,1],"lines":["a"],"registers":{"\"":["\nc\nd\n","V"],"1":["\nc\nd\n","V"]}}},
    {"name": "dip on blank lines", "lines": ["a","","","c"], "cursor": [2,1], "keys": "dip", "expect": {"cursor":[2,1],"lines":["a","c"],"registers":{"\"":["\n\n","V"],"1":["\n\n","V"]}}},
    {"name": "yap", "lines": ["a","b","","c"], "cursor": [2,1], "keys": "yap", "expect": {"cursor":[1,1],"lines":["a","b","","c"],"registers":{"\"":["a\nb\n\n","V"],"0":["a\nb\n\n","V"]}}},
    {"name": "d2ap", "lines": ["a","","b","","c"], "cursor": [1,1], "keys": "d2ap", "expect": {"cursor":[1,1],"lines":["c"],"registers":{"\"":["a\n\nb\n\n","V"],"1":["a\n\nb\n\n","V"]}}},
    {"name": "dis", "lines": ["One two.  Three four. Five six."], "cursor": [1,14], "keys": "dis", "expect": {"cursor":[1,11],"lines":["One two.   Five six."],"registers":{"\"":["Three four.","v"],"-":["Three four.","v"]}}},
    {"name": "das", "lines": ["One two.  Three four. Five six."], "cursor": [1,14], "keys": "das", "expect": {"cursor":[1,11],"lines":["One two.  Five six."],"registers":{"\"":["Three four. ","v"],"-":["Three four. ","v"]}}},
    {"name": "das on the last sentence", "lines": ["One two.  Three four."], "cursor": [1,14], "keys": "das", "expect": {"cursor":[1,8],"lines":["One two."],"registers":{"\"":["  Three four.","v"],"-":["  Three four.","v"]}}},
    {"name": "cis", "lines": ["One two. Three four."], "cursor": [1,2], "keys": "cisX.<Esc>", "expect": {"cursor":[1,2],"lines":["X. Three four."],"registers":{"\"":["One two.","v"],"-":["One two.","v"],".":["X.","v"]}}}
  ]
}
