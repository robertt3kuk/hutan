{
  "vim": "VIM - Vi IMproved 9.1, patches 1-1752 (/usr/bin/vim -Nu NONE -i NONE -es)",
  "cases": [
    {"name": "named yank and put", "lines": ["foo bar"], "cursor": [1,1], "keys": "\"ayiww\"aP", "expect": {"cursor":[1,7],"lines":["foo foobar"],"registers":{"\"":["foo","v"],"a":["foo","v"]}}},
    {"name": "named linewise", "lines": ["one","two"], "cursor": [1,1], "keys": "\"byyj\"bp", "expect": {"cursor":[3,1],"lines":["one","two","one"],"registers":{"\"":["one\n","V"],"b":["one\n","V"]}}},
    {"name": "append to a named register", "lines": ["foo bar"], "cursor": [1,1], "keys": "\"ayiww\"Ayiw$\"ap", "expect": {"cursor":[1,13],"lines":["foo barfoobar"],"registers":{"\"":["foobar","v"],"a":["foobar","v"]}}},
    {"name": "append lines to chars", "lines": ["foo","bar"], "cursor": [1,1], "keys": "\"ayiwj\"Ayy", "expect": {"cursor":[2,1],"lines":["foo","bar"],"registers":{"\"":["foo\nbar\n","V"],"a":["foo\nbar\n","V"]}}},
    {"name": "append chars to lines", "lines": ["foo","bar"], "cursor": [1,1], "keys": "\"ayyj\"Ayiw", "expect": {"cursor":[2,1],"lines":["foo","bar"],"registers":{"\"":["foo\nbar\n","V"],"a":["foo\nbar\n","V"]}}},
    {"name": "yank goes to 0", "lines": ["foo bar"], "cursor": [1,1], "keys": "yiw", "expect": {"cursor":[1,1],"lines":["foo bar"],"registers":{"\"":["foo","v"],"0":["foo","v"]}}},
    {"name": "small delete goes to minus", "lines": ["foo bar"], "cursor": [1,1], "keys": "dw", "expect": {"cursor":[1,1],"lines":["bar"],"registers":{"\"":["foo ","v"],"-":["foo ","v"]}}},
    {"name": "line delete goes to 1", "lines": ["one","two","three"], "cursor": [1,1], "keys": "dd", "expect": {"cursor":[1,1],"lines":["two","three"],"registers":{"\"":["one\n","V"],"1":["one\n","V"]}}},
    {"name": "numbered registers shift", "lines": ["1","2","3","4"], "cursor": [1,1], "keys": "dddddd", "expect": {"cursor":[1,1],"lines":["4"],"registers":{"\"":["3\n","V"],"1":["3\n","V"],"2":["2\n","V"],"3":["1\n","V"]}}},
    {"name": "yank then delete keeps 0", "lines": ["foo bar","baz"], "cursor": [1,1], "keys": "yiwjddk\"0p", "expect": {"cursor":[1,4],"lines":["ffoooo bar"],"registers":{"\"":["baz\n","V"],"0":["foo","v"],"1":["baz\n","V"]}}},
    {"name": "multi-line charwise delete goes to 1", "lines": ["abc","def"], "cursor": [1,2], "keys": "vjd", "expect": {"cursor":[1,2],"lines":["af"],"registers":{"\"":["bc\nde","v"],"1":["bc\nde","v"]}}},
    {"name": "delete with percent goes to 1", "lines": ["(a b)"], "cursor": [1,1], "keys": "d%", "expect": {"cursor":[1,1],"lines":[""],"registers":{"\"":["(a b)","v"],"-":["(a b)","v"],"1":["(a b)","v"]}}},
    {"name": "delete with a search goes to 1", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "d/baz<CR>", "expect": {"cursor":[1,1],"lines":["baz"],"registers":{"\"":["foo bar ","v"],"-":["foo bar ","v"],"/":["baz","v"],"1":["foo bar ","v"]}}},
    {"name": "named delete skips minus", "lines": ["foo bar"], "cursor": [1,1], "keys": "\"adw", "expect": {"cursor":[1,1],"lines":["bar"],"registers":{"\"":["foo ","v"],"1":["foo ","v"],"a":["foo ","v"]}}},
    {"name": "named line delete also goes to 1", "lines": ["one","two"], "cursor": [1,1], "keys": "\"add", "expect": {"cursor":[1,1],"lines":["two"],"registers":{"\"":["one\n","V"],"1":["one\n","V"],"a":["one\n","V"]}}},
    {"name": "black hole", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "yiww\"_dwP", "expect": {"cursor":[1,7],"lines":["foo foobaz"],"registers":{"\"":["foo","v"],"0":["foo","v"]}}},
    {"name": "black hole line", "lines": ["one","two"], "cursor": [1,1], "keys": "yyj\"_ddP", "expect": {"cursor":[1,1],"lines":["one","one"],"registers":{"\"":["one\n","V"],"0":["one\n","V"]}}},
    {"name": "put from 1", "lines": ["one","two","three"], "cursor": [1,1], "keys": "dddd\"1p", "expect": {"cursor":[2,1],"lines":["three","two"],"registers":{"\"":["two\n","V"],"1":["two\n","V"],"2":["one\n","V"]}}},
    {"name": "put from 2", "lines": ["one","two","three"], "cursor": [1,1], "keys": "dddd\"2p", "expect": {"cursor":[2,1],"lines":["three","one"],"registers":{"\"":["two\n","V"],"1":["two\n","V"],"2":["one\n","V"]}}},
    {"name": "dot register", "lines": ["x"], "cursor": [1,1], "keys": "ahello<Esc>", "expect": {"cursor":[1,6],"lines":["xhello"],"registers":{".":["hello","v"]}}},
    {"name": "put the dot register", "lines": ["x"], "cursor": [1,1], "keys": "aab<Esc>\".p", "expect": {"cursor":[1,5],"lines":["xabab"],"registers":{".":["ab","v"]}}},
    {"name": "colon register", "lines": ["foo"], "cursor": [1,1], "keys": ":s/o/0/<CR>", "expect": {"cursor":[1,1],"lines":["f0o"],"registers":{"/":["o","v"],":":["s/o/0/","v"]}}},
    {"name": "slash register", "lines": ["foo bar"], "cursor": [1,1], "keys": "/bar<CR>", "expect": {"cursor":[1,5],"lines":["foo bar"],"registers":{"/":["bar","v"]}}},
    {"name": "p with a count", "lines": ["ab"], "cursor": [1,1], "keys": "yl3p", "expect": {"cursor":[1,4],"lines":["aaaab"],"registers":{"\"":["a","v"],"0":["a","v"]}}},
    {"name": "P with a count of lines", "lines": ["one","two"], "cursor": [2,1], "keys": "yy2P", "expect": {"cursor":[2,1],"lines":["one","two","two","two"],"registers":{"\"":["two\n","V"],"0":["two\n","V"]}}},
    {"name": "gp leaves the caret after", "lines": ["ab","cd"], "cursor": [1,1], "keys": "yygp", "expect": {"cursor":[3,1],"lines":["ab","ab","cd"],"registers":{"\"":["ab\n","V"],"0":["ab\n","V"]}}},
    {"name": "gP leaves the caret after", "lines": ["ab","cd"], "cursor": [1,1], "keys": "yiwgPx", "expect": {"cursor":[1,3],"lines":["abb","cd"],"registers":{"\"":["a","v"],"-":["a","v"],"0":["ab","v"]}}},
    {"name": "gp charwise", "lines": ["abc"], "cursor": [1,1], "keys": "ylgpx", "expect": {"cursor":[1,3],"lines":["aac"],"registers":{"\"":["b","v"],"-":["b","v"],"0":["a","v"]}}},
    {"name": "put a multi-line charwise text", "lines": ["abc","def","ghi"], "cursor": [1,2], "keys": "vjy$p", "expect": {"cursor":[1,4],"lines":["abcbc","de","def","ghi"],"registers":{"\"":["bc\nde","v"],"0":["bc\nde","v"]}}},
    {"name": "put with nothing fails", "lines": ["abc"], "cursor": [1,1], "keys": "\"zp", "expect": {"cursor":[1,1],"lines":["abc"],"registers":{}}},
    {"name": "p on an empty line", "lines": ["abc",""], "cursor": [1,1], "keys": "ywjp", "expect": {"cursor":[2,3],"lines":["abc","abc"],"registers":{"\"":["abc","v"],"0":["abc","v"]}}},
    {"name": "x then p swaps", "lines": ["abcd"], "cursor": [1,1], "keys": "xp", "expect": {"cursor":[1,2],"lines":["bacd"],"registers":{"\"":["a","v"],"-":["a","v"]}}},
    {"name": "dd then p swaps lines", "lines": ["one","two","three"], "cursor": [1,1], "keys": "ddp", "expect": {"cursor":[2,1],"lines":["two","one","three"],"registers":{"\"":["one\n","V"],"1":["one\n","V"]}}},
    {"name": "Y with a register", "lines": ["one","two"], "cursor": [1,1], "keys": "\"qYj\"qP", "expect": {"cursor":[2,1],"lines":["one","one","two"],"registers":{"\"":["one\n","V"],"q":["one\n","V"]}}},
    {"name": "count and register in either order", "lines": ["a","b","c","d"], "cursor": [1,1], "keys": "2\"ayy\"a3yyG\"ap", "expect": {"cursor":[5,1],"lines":["a","b","c","d","a","b","c"],"registers":{"\"":["a\nb\nc\n","V"],"a":["a\nb\nc\n","V"]}}},
    {"name": "yank into an uppercase register first", "lines": ["foo"], "cursor": [1,1], "keys": "\"Fyiw", "expect": {"cursor":[1,1],"lines":["foo"],"registers":{"\"":["foo","v"],"f":["foo","v"]}}},
    {"name": "change goes to minus", "lines": ["foo bar"], "cursor": [1,1], "keys": "cwX<Esc>", "expect": {"cursor":[1,1],"lines":["X bar"],"registers":{"\"":["foo","v"],"-":["foo","v"],".":["X","v"]}}},
    {"name": "cc goes to 1", "lines": ["foo","bar"], "cursor": [1,1], "keys": "ccX<Esc>", "expect": {"cursor":[1,1],"lines":["X","bar"],"registers":{"\"":["foo\n","V"],".":["X","v"],"1":["foo\n","V"]}}}
  ]
}
