{
  "vim": "VIM - Vi IMproved 9.1, patches 1-1752 (/usr/bin/vim -Nu NONE -i NONE -es)",
  "cases": [
    {"name": "slash forward", "lines": ["foo bar foo","bar foo"], "cursor": [1,1], "keys": "/foo<CR>", "expect": {"cursor":[1,9],"lines":["foo bar foo","bar foo"],"registers":{"/":["foo","v"]}}},
    {"name": "n and N", "lines": ["foo bar foo","bar foo"], "cursor": [1,1], "keys": "/foo<CR>nN", "expect": {"cursor":[1,9],"lines":["foo bar foo","bar foo"],"registers":{"/":["foo","v"]}}},
    {"name": "search wraps around", "lines": ["foo","bar","baz"], "cursor": [2,1], "keys": "/foo<CR>", "expect": {"cursor":[1,1],"lines":["foo","bar","baz"],"registers":{"/":["foo","v"]}}},
    {"name": "search without wrapscan fails", "lines": ["foo","bar","baz"], "cursor": [2,1], "set": "nows", "keys": "/foo<CR>", "expect": {"cursor":[2,1],"lines":["foo","bar","baz"],"registers":{"/":["foo","v"]}}},
    {"name": "question backward", "lines": ["foo bar foo","bar foo"], "cursor": [2,5], "keys": "?bar<CR>", "expect": {"cursor":[2,1],"lines":["foo bar foo","bar foo"],"registers":{"/":["bar","v"]}}},
    {"name": "question then n goes backward", "lines": ["foo bar foo","bar foo"], "cursor": [2,5], "keys": "?foo<CR>n", "expect": {"cursor":[1,1],"lines":["foo bar foo","bar foo"],"registers":{"/":["foo","v"]}}},
    {"name": "question then N goes forward", "lines": ["foo bar foo","bar foo"], "cursor": [1,1], "keys": "?foo<CR>N", "expect": {"cursor":[1,1],"lines":["foo bar foo","bar foo"],"registers":{"/":["foo","v"]}}},
    {"name": "search count", "lines": ["x x x x x"], "cursor": [1,1], "keys": "3/x<CR>", "expect": {"cursor":[1,7],"lines":["x x x x x"],"registers":{"/":["x","v"]}}},
    {"name": "n with a count", "lines": ["x x x x x"], "cursor": [1,1], "keys": "/x<CR>2n", "expect": {"cursor":[1,7],"lines":["x x x x x"],"registers":{"/":["x","v"]}}},
    {"name": "not found", "lines": ["foo bar"], "cursor": [1,1], "keys": "/nope<CR>", "expect": {"cursor":[1,1],"lines":["foo bar"],"registers":{"/":["nope","v"]}}},
    {"name": "empty pattern reuses the last", "lines": ["ab ab ab"], "cursor": [1,1], "keys": "/ab<CR>/<CR>", "expect": {"cursor":[1,7],"lines":["ab ab ab"],"registers":{"/":["ab","v"]}}},
    {"name": "star", "lines": ["foo bar foo foobar foo"], "cursor": [1,1], "keys": "*", "expect": {"cursor":[1,9],"lines":["foo bar foo foobar foo"],"registers":{"/":["\\<foo\\>","v"]}}},
    {"name": "star twice", "lines": ["foo bar foo foobar foo"], "cursor": [1,1], "keys": "**", "expect": {"cursor":[1,20],"lines":["foo bar foo foobar foo"],"registers":{"/":["\\<foo\\>","v"]}}},
    {"name": "star from the middle of a word", "lines": ["foo bar foo"], "cursor": [1,2], "keys": "*", "expect": {"cursor":[1,9],"lines":["foo bar foo"],"registers":{"/":["\\<foo\\>","v"]}}},
    {"name": "hash backward", "lines": ["foo bar foo foobar foo"], "cursor": [1,20], "keys": "#", "expect": {"cursor":[1,9],"lines":["foo bar foo foobar foo"],"registers":{"/":["\\<foo\\>","v"]}}},
    {"name": "g star matches inside words", "lines": ["foo bar foobar foo"], "cursor": [1,1], "keys": "g*", "expect": {"cursor":[1,9],"lines":["foo bar foobar foo"],"registers":{"/":["foo","v"]}}},
    {"name": "star on punctuation", "lines": ["a -> b -> c"], "cursor": [1,3], "keys": "*", "expect": {"cursor":[1,6],"lines":["a -> b -> c"],"registers":{"/":["\\<b\\>","v"]}}},
    {"name": "star then n", "lines": ["foo x foo y foo"], "cursor": [1,1], "keys": "*n", "expect": {"cursor":[1,13],"lines":["foo x foo y foo"],"registers":{"/":["\\<foo\\>","v"]}}},
    {"name": "star with ignorecase", "lines": ["foo x FOO y"], "cursor": [1,1], "set": "ic", "keys": "*", "expect": {"cursor":[1,7],"lines":["foo x FOO y"],"registers":{"/":["\\<foo\\>","v"]}}},
    {"name": "ignorecase", "lines": ["x FOO y foo"], "cursor": [1,1], "set": "ic", "keys": "/foo<CR>", "expect": {"cursor":[1,3],"lines":["x FOO y foo"],"registers":{"/":["foo","v"]}}},
    {"name": "smartcase with an uppercase letter", "lines": ["x foo y Foo"], "cursor": [1,1], "set": "ic scs", "keys": "/Foo<CR>", "expect": {"cursor":[1,9],"lines":["x foo y Foo"],"registers":{"/":["Foo","v"]}}},
    {"name": "backslash c", "lines": ["x FOO y foo"], "cursor": [1,1], "keys": "/foo\\c<CR>", "expect": {"cursor":[1,3],"lines":["x FOO y foo"],"registers":{"/":["foo\\c","v"]}}},
    {"name": "word boundaries", "lines": ["foobar foo"], "cursor": [1,1], "keys": "/\\<foo\\><CR>", "expect": {"cursor":[1,8],"lines":["foobar foo"],"registers":{"/":["\\<foo\\>","v"]}}},
    {"name": "dot and star", "lines": ["axxb ab"], "cursor": [1,2], "keys": "/a.*b<CR>", "expect": {"cursor":[1,1],"lines":["axxb ab"],"registers":{"/":["a.*b","v"]}}},
    {"name": "start of line", "lines": ["foo x","foo y"], "cursor": [1,2], "keys": "/^foo<CR>", "expect": {"cursor":[2,1],"lines":["foo x","foo y"],"registers":{"/":["^foo","v"]}}},
    {"name": "end of line", "lines": ["foo x","y foo"], "cursor": [1,1], "keys": "/foo$<CR>", "expect": {"cursor":[2,3],"lines":["foo x","y foo"],"registers":{"/":["foo$","v"]}}},
    {"name": "magic plus", "lines": ["ab aab"], "cursor": [1,1], "keys": "/a\\+b<CR>", "expect": {"cursor":[1,4],"lines":["ab aab"],"registers":{"/":["a\\+b","v"]}}},
    {"name": "very magic", "lines": ["x ab12 cd"], "cursor": [1,1], "keys": "/\\v[a-z]+\\d+<CR>", "expect": {"cursor":[1,3],"lines":["x ab12 cd"],"registers":{"/":["\\v[a-z]+\\d+","v"]}}},
    {"name": "very nomagic", "lines": ["x a.b a*b"], "cursor": [1,1], "keys": "/\\Va*b<CR>", "expect": {"cursor":[1,7],"lines":["x a.b a*b"],"registers":{"/":["\\Va*b","v"]}}},
    {"name": "literal parens in magic", "lines": ["f(x) g"], "cursor": [1,3], "keys": "/(x)<CR>", "expect": {"cursor":[1,2],"lines":["f(x) g"],"registers":{"/":["(x)","v"]}}},
    {"name": "alternation", "lines": ["x cat dog"], "cursor": [1,1], "keys": "/dog\\|cat<CR>", "expect": {"cursor":[1,3],"lines":["x cat dog"],"registers":{"/":["dog\\|cat","v"]}}},
    {"name": "braces count", "lines": ["a aa aaa"], "cursor": [1,1], "keys": "/a\\{3}<CR>", "expect": {"cursor":[1,6],"lines":["a aa aaa"],"registers":{"/":["a\\{3}","v"]}}},
    {"name": "collection", "lines": ["x 1 y 2"], "cursor": [1,1], "keys": "/[0-9]<CR>", "expect": {"cursor":[1,3],"lines":["x 1 y 2"],"registers":{"/":["[0-9]","v"]}}},
    {"name": "negated collection", "lines": ["aaa1b"], "cursor": [1,1], "keys": "/[^a]<CR>", "expect": {"cursor":[1,4],"lines":["aaa1b"],"registers":{"/":["[^a]","v"]}}},
    {"name": "backslash s", "lines": ["foo bar"], "cursor": [1,1], "keys": "/\\s<CR>", "expect": {"cursor":[1,4],"lines":["foo bar"],"registers":{"/":["\\s","v"]}}},
    {"name": "zs", "lines": ["foobar foobaz"], "cursor": [1,1], "keys": "/foo\\zsbaz<CR>", "expect": {"cursor":[1,11],"lines":["foobar foobaz"],"registers":{"/":["foo\\zsbaz","v"]}}},
    {"name": "offset e", "lines": ["x foobar"], "cursor": [1,1], "keys": "/foo/e<CR>", "expect": {"cursor":[1,5],"lines":["x foobar"],"registers":{"/":["foo","v"]}}},
    {"name": "offset s plus", "lines": ["x foobar"], "cursor": [1,1], "keys": "/foo/s+2<CR>", "expect": {"cursor":[1,5],"lines":["x foobar"],"registers":{"/":["foo","v"]}}},
    {"name": "offset b minus", "lines": ["x foobar"], "cursor": [1,1], "keys": "/bar/b-1<CR>", "expect": {"cursor":[1,5],"lines":["x foobar"],"registers":{"/":["bar","v"]}}},
    {"name": "line offset", "lines": ["a","foo","b","  c"], "cursor": [1,1], "keys": "/foo/+2<CR>", "expect": {"cursor":[4,1],"lines":["a","foo","b","  c"],"registers":{"/":["foo","v"]}}},
    {"name": "d slash", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "d/baz<CR>", "expect": {"cursor":[1,1],"lines":["baz"],"registers":{"\"":["foo bar ","v"],"-":["foo bar ","v"],"/":["baz","v"],"1":["foo bar ","v"]}}},
    {"name": "c slash", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "c/baz<CR>X<Esc>", "expect": {"cursor":[1,1],"lines":["Xbaz"],"registers":{"\"":["foo bar ","v"],"-":["foo bar ","v"],".":["X","v"],"/":["baz","v"],"1":["foo bar ","v"]}}},
    {"name": "d slash across lines from the line start", "lines": ["a","b","c"], "cursor": [1,1], "keys": "d/c<CR>", "expect": {"cursor":[1,1],"lines":["c"],"registers":{"\"":["a\nb\n","V"],"/":["c","v"],"1":["a\nb\n","V"]}}},
    {"name": "dn", "lines": ["x foo y foo z"], "cursor": [1,1], "keys": "/foo<CR>0dn", "expect": {"cursor":[1,1],"lines":["foo y foo z"],"registers":{"\"":["x ","v"],"-":["x ","v"],"/":["foo","v"],"1":["x ","v"]}}},
    {"name": "d slash e is inclusive", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "d/bar/e<CR>", "expect": {"cursor":[1,1],"lines":[" baz"],"registers":{"\"":["foo bar","v"],"-":["foo bar","v"],"/":["bar","v"],"1":["foo bar","v"]}}},
    {"name": "backspace edits the search", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "/bax<BS>z<CR>", "expect": {"cursor":[1,9],"lines":["foo bar baz"],"registers":{"/":["baz","v"]}}},
    {"name": "escape cancels the search", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "/baz<Esc>", "expect": {"cursor":[1,1],"lines":["foo bar baz"],"registers":{}}},
    {"name": "search in visual extends", "lines": ["foo bar baz"], "cursor": [1,1], "keys": "v/baz<CR>d", "expect": {"cursor":[1,1],"lines":["az"],"registers":{"\"":["foo bar b","v"],"-":["foo bar b","v"],"/":["baz","v"]}}},
    {"name": "search a multibyte word", "lines": ["x привет y привет"], "cursor": [1,1], "keys": "/привет<CR>n", "expect": {"cursor":[1,18],"lines":["x привет y привет"],"registers":{"/":["привет","v"]}}},
    {"name": "dot repeats d slash", "lines": ["a x b x c x"], "cursor": [1,1], "keys": "d/x<CR>l.", "expect": {"cursor":[1,2],"lines":["xx c x"],"registers":{"\"":[" b ","v"],"-":[" b ","v"],"/":["x","v"],"1":[" b ","v"],"2":["a ","v"]}}}
  ]
}
