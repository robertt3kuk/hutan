; Indentation scopes (MIT OR Apache-2.0).
[
  (function_definition)
  (class_definition)
  (if_statement)
  (for_statement)
  (while_statement)
  (try_statement)
  (with_statement)
  (match_statement)
  (case_clause)
  (list)
  (dictionary)
  (set)
  (tuple)
  (argument_list)
  (parameters)
  (parenthesized_expression)
] @indent

[
  (else_clause)
  (elif_clause)
  (except_clause)
  (finally_clause)
] @outdent

[ ")" "]" "}" ] @outdent
